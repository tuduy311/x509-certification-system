# ==========================================
# X509 Certification System - Configuration
# ==========================================

# Database Configuration
DATABASE_URL=sqlite:///./sql_app.db

# Security Configuration (REQUIRED)
SECRET_KEY=your-very-secret-key-change-this-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin Account (REQUIRED - Cannot be empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# CORS Configuration (comma-separated domains)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://example.com

# Certificate Configuration
CERTIFICATE_VALIDITY_DAYS=365
ROOT_CA_PATH=./root_ca
COUNTRY_NAME=VN
STATE_OR_PROVINCE_NAME=Hanoi
LOCALITY_NAME=Hanoi
ORGANIZATION_NAME=My CA
