# ==============================================================================
# X509 Certification System
# ==============================================================================

# Database Configuration (Using Absolute or Clean Relative SQLite Path)
DATABASE_URL=sqlite:///./sql_app.db

# Cryptographic & Session Security
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Immutable Root Administrator Identity
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Cross-Origin Resource Sharing (CORS) - Parsed dynamically as a list
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://localhost:8501"]

# PKI Architecture & Directory Layout
COUNTRY_NAME=VN
STATE_OR_PROVINCE_NAME=Tp Ho Chi Minh
LOCALITY_NAME=HCMUS
ORGANIZATION_NAME=Nhom 12 cua thay Minh